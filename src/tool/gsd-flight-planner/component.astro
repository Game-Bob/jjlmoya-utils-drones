---
const { ui } = Astro.props;
---

<div class="gsd-flight-planner-ui" data-ui={JSON.stringify(ui)}>
  <!-- Main Card -->
  <div class="main-card">
    <!-- Unit Toggle in Top Right Corner -->
    <div class="unit-toggle unit-toggle-corner">
      <button id="metricBtn" class="unit-btn active">Metric</button>
      <button id="imperialBtn" class="unit-btn">Imperial</button>
    </div>

    <!-- Left Column: Inputs -->
    <div class="column column-inputs">
      <h2 class="column-title">Configuration</h2>

      <div class="section">
        <label class="section-label">{ui.cameraSelection || "Camera Model"}</label>
        <select id="cameraPreset" class="input-field">
          <option value="">{ui.manualMode || "Custom Camera"}</option>
          <option value="mavic3e">{ui.presetDjiMavic3e || "DJI Mavic 3E"}</option>
          <option value="matrice300">{ui.presetDjiMatrice300 || "DJI Matrice 300 RTK"}</option>
          <option value="autelevoii">{ui.presetAutelEvoII || "Autel EVO II"}</option>
          <option value="air3s">{ui.presetDjiAir3s || "DJI Air 3S"}</option>
        </select>
      </div>

      <div class="section">
        <label class="section-label">{ui.sensorConfig || "Sensor Dimensions"}</label>
        <div class="input-row">
          <div class="input-item">
            <span class="input-label">Width</span>
            <input id="sensorWidth" type="number" min="1" max="100" step="0.1" value="23.5" class="input-field" />
            <span class="unit-hint">mm</span>
          </div>
          <div class="input-item">
            <span class="input-label">Height</span>
            <input id="sensorHeight" type="number" min="1" max="100" step="0.1" value="15.6" class="input-field" />
            <span class="unit-hint">mm</span>
          </div>
        </div>
      </div>

      <div class="section">
        <label class="section-label">{ui.focalLength || "Focal Length"}</label>
        <div class="input-item">
          <input id="focalLength" type="number" min="1" max="1000" step="0.1" value="35" class="input-field" />
          <span class="unit-hint" id="focalLengthUnit">mm</span>
        </div>
      </div>

      <div class="section">
        <label class="section-label">{ui.imageResolution || "Image Resolution"}</label>
        <div class="input-row">
          <div class="input-item">
            <span class="input-label">W</span>
            <input id="imageWidth" type="number" min="100" max="50000" step="1" value="5472" class="input-field" />
            <span class="unit-hint">px</span>
          </div>
          <div class="input-item">
            <span class="input-label">H</span>
            <input id="imageHeight" type="number" min="100" max="50000" step="1" value="3648" class="input-field" />
            <span class="unit-hint">px</span>
          </div>
        </div>
      </div>

      <div class="section">
        <label class="section-label">{ui.altitudeAgl || "Flight Altitude"}</label>
        <div class="input-item">
          <input id="altitudeAgl" type="number" min="10" max="500" step="5" value="100" class="input-field" />
          <span class="unit-hint" id="altUnit">m</span>
        </div>
        <input id="altitudeSlider" type="range" min="10" max="500" step="5" value="100" class="slider" />
      </div>

      <div class="section">
        <label class="section-label">{ui.overlapSettings || "Image Overlap"}</label>
        <div class="input-row">
          <div class="input-item">
            <span class="input-label">Forward</span>
            <input id="forwardOverlap" type="number" min="0" max="95" step="5" value="75" class="input-field" />
            <span class="unit-hint">%</span>
          </div>
          <div class="input-item">
            <span class="input-label">Lateral</span>
            <input id="lateralOverlap" type="number" min="0" max="95" step="5" value="65" class="input-field" />
            <span class="unit-hint">%</span>
          </div>
        </div>
      </div>

      <div class="section">
        <label class="section-label">Mission Area</label>
        <div class="input-item">
          <span class="input-label">Total Area to Survey</span>
          <input id="missionArea" type="number" min="0.1" max="10000" step="0.1" value="100" class="input-field" title="1 hectare = 10,000 m²" />
          <span class="unit-hint" id="areaInputUnit">m²</span>
          <span class="unit-hint" style="font-size: 0.65rem; margin-top: 0.25rem;">1 ha = 10,000 m²</span>
        </div>
      </div>

      <div class="section">
        <label class="section-label">{ui.inverseCalc || "Target GSD"}</label>
        <div class="input-item">
          <input id="desiredGsd" type="number" min="0.1" max="50" step="0.1" value="2" class="input-field" />
          <span class="unit-hint" id="desiredGsdUnit">cm/px</span>
        </div>
        <div class="result-box">
          <span class="result-label">Max Altitude</span>
          <span class="result-value" id="maxAltResult">0.00 m</span>
        </div>
      </div>

      <button id="resetBtn" class="btn-secondary">Reset</button>
    </div>

    <!-- Divider -->
    <div class="divider"></div>

    <!-- Right Column: Results -->
    <div class="column column-results">
      <h2 class="column-title">Results</h2>

      <!-- GSD Display -->
      <div class="result-section">
        <div class="result-header">Ground Sample Distance</div>
        <div class="gsd-large">
          <div class="gsd-number" id="gsdNumberLarge">0.00</div>
          <div class="gsd-label" id="gsdUnitLabel">cm/px</div>
        </div>

        <div class="precision-bar">
          <div class="bar-track">
            <div class="bar-fill" id="scaleFill"></div>
          </div>
          <div class="bar-labels">
            <span class="bar-label-item" title="High-Precision Topography (1-2 cm/px): Ideal for contour lines and detailed surveys">High Prec.</span>
            <span class="bar-label-item" title="Standard Mapping (2-5 cm/px): Orthomosaics and general-purpose maps">Standard</span>
            <span class="bar-label-item" title="Inspection & Monitoring (5-10 cm/px): Infrastructure and change detection">Inspection</span>
            <span class="bar-label-item" title="Visual Survey (10+ cm/px): Wide-area reconnaissance">Visual</span>
          </div>
        </div>

        <div class="classification" id="classificationBadge">—</div>
      </div>

      <!-- Coverage Display -->
      <div class="result-section">
        <div class="result-header">Coverage per Image</div>
        <div class="coverage-display">
          <div class="coverage-stat">
            <span class="stat-label">Area</span>
            <span class="stat-value" id="areaDisplay">0</span>
            <span class="stat-unit" id="areaUnit">m²</span>
          </div>
          <div class="coverage-stat">
            <span class="stat-label">Spacing</span>
            <span class="stat-value" id="spacingDisplay">0</span>
            <span class="stat-unit" id="spacingUnit">m</span>
          </div>
        </div>

        <svg class="coverage-visual" viewBox="0 0 220 100">
          <!-- Reference grid -->
          <defs>
            <pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
              <path d="M 10 0 L 0 0 0 10" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.1"/>
            </pattern>
          </defs>
          <rect width="220" height="100" fill="url(#grid)"/>

          <!-- Flight direction indicator -->
          <text x="10" y="95" font-size="8" opacity="0.4">Flight →</text>

          <!-- First photo -->
          <rect id="photo1Rect" x="20" y="30" width="80" height="40" fill="currentColor" opacity="0.25" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2,2"/>

          <!-- Second photo with overlap -->
          <rect id="photo2Rect" x="70" y="30" width="80" height="40" fill="currentColor" opacity="0.15" stroke="currentColor" stroke-width="1.5"/>

          <!-- Overlap indicator -->
          <rect id="overlapRect" x="70" y="30" width="30" height="40" fill="currentColor" opacity="0.4" stroke="none"/>

          <!-- Labels -->
          <text id="overlapText" x="85" y="58" font-size="9" text-anchor="middle" fill="currentColor" font-weight="bold" opacity="0.8">70%</text>
        </svg>
      </div>

      <!-- Mission Metrics -->
      <div class="result-section">
        <div class="result-header">Mission Metrics</div>
        <div class="metrics-display">
          <div class="metric-item">
            <span class="metric-label">Images</span>
            <span class="metric-number" id="totalImages">0</span>
            <span class="metric-unit">shots</span>
          </div>
          <div class="metric-item">
            <span class="metric-label">Flight Lines</span>
            <span class="metric-number" id="flightLines">0</span>
            <span class="metric-unit">lines</span>
          </div>
          <div class="metric-item">
            <span class="metric-label">Flight Time</span>
            <span class="metric-number" id="flightTime">0</span>
            <span class="metric-unit">min</span>
          </div>
          <div class="metric-item">
            <span class="metric-label">Data Volume</span>
            <span class="metric-number" id="dataVolume">0</span>
            <span class="metric-unit">GB</span>
          </div>
        </div>
      </div>

      <!-- Alerts -->
      <div id="alertsContainer" class="alerts-container"></div>

      <!-- Share and Export -->
      <button id="shareBtn" class="btn-primary" style="margin-bottom: 0.75rem;">Copy Share Link</button>
      <button id="exportBtn" class="btn-secondary">Download Report</button>
    </div>
  </div>
</div>

<script>
  const cameraPresets: Record<string, { sensorW: number; sensorH: number; imgW: number; imgH: number; focal: number }> = {
    mavic3e: { sensorW: 17.3, sensorH: 13, imgW: 5280, imgH: 3956, focal: 24 },
    matrice300: { sensorW: 35.9, sensorH: 24, imgW: 8688, imgH: 5792, focal: 35 },
    autelevoii: { sensorW: 21.3, sensorH: 12, imgW: 6000, imgH: 3376, focal: 20 },
    air3s: { sensorW: 21.3, sensorH: 12, imgW: 6000, imgH: 3376, focal: 21.1 },
  };

  let currentUnit: 'metric' | 'imperial' = 'metric';

  // Load from localStorage or query params
  function loadState() {
    const params = new URLSearchParams(window.location.search);

    if (params.size > 0) {
      // Load from URL params
      if (params.has('sensorW')) sensorWidthInput.value = params.get('sensorW')!;
      if (params.has('sensorH')) sensorHeightInput.value = params.get('sensorH')!;
      if (params.has('focalLength')) focalLengthInput.value = params.get('focalLength')!;
      if (params.has('imgW')) imageWidthInput.value = params.get('imgW')!;
      if (params.has('imgH')) imageHeightInput.value = params.get('imgH')!;
      if (params.has('altitude')) altitudeInput.value = altitudeSlider.value = params.get('altitude')!;
      if (params.has('forward')) forwardOverlapInput.value = params.get('forward')!;
      if (params.has('lateral')) lateralOverlapInput.value = params.get('lateral')!;
      if (params.has('area')) missionAreaInput.value = params.get('area')!;
      if (params.has('unit')) {
        const unit = params.get('unit') as 'metric' | 'imperial';
        if (unit === 'imperial') {
          imperialBtn.click();
        }
      }
    } else {
      // Load from localStorage
      const saved = localStorage.getItem('gsd-planner-state');
      const unitPref = localStorage.getItem('gsd-planner-unit') || 'metric';

      if (saved) {
        try {
          const state = JSON.parse(saved);
          sensorWidthInput.value = state.sensorW || sensorWidthInput.value;
          sensorHeightInput.value = state.sensorH || sensorHeightInput.value;
          focalLengthInput.value = state.focalLength || focalLengthInput.value;
          imageWidthInput.value = state.imgW || imageWidthInput.value;
          imageHeightInput.value = state.imgH || imageHeightInput.value;
          altitudeInput.value = altitudeSlider.value = state.altitude || altitudeInput.value;
          forwardOverlapInput.value = state.forward || forwardOverlapInput.value;
          lateralOverlapInput.value = state.lateral || lateralOverlapInput.value;
          missionAreaInput.value = state.area || missionAreaInput.value;
        } catch (e) {
          // Ignore invalid JSON
        }
      }

      // Apply unit preference
      if (unitPref === 'imperial') {
        imperialBtn.click();
      }
    }
  }

  function saveState() {
    const state = {
      sensorW: sensorWidthInput.value,
      sensorH: sensorHeightInput.value,
      focalLength: focalLengthInput.value,
      imgW: imageWidthInput.value,
      imgH: imageHeightInput.value,
      altitude: altitudeInput.value,
      forward: forwardOverlapInput.value,
      lateral: lateralOverlapInput.value,
      area: missionAreaInput.value,
      unit: currentUnit,
    };
    localStorage.setItem('gsd-planner-state', JSON.stringify(state));
    localStorage.setItem('gsd-planner-unit', currentUnit);
  }

  function getShareUrl(): string {
    const params = new URLSearchParams({
      sensorW: sensorWidthInput.value,
      sensorH: sensorHeightInput.value,
      focalLength: focalLengthInput.value,
      imgW: imageWidthInput.value,
      imgH: imageHeightInput.value,
      altitude: altitudeInput.value,
      forward: forwardOverlapInput.value,
      lateral: lateralOverlapInput.value,
      area: missionAreaInput.value,
      unit: currentUnit,
    });
    const url = new URL(window.location.href);
    url.search = params.toString();
    return url.toString();
  }

  const cameraPresetSelect = document.getElementById('cameraPreset') as HTMLSelectElement;
  const sensorWidthInput = document.getElementById('sensorWidth') as HTMLInputElement;
  const sensorHeightInput = document.getElementById('sensorHeight') as HTMLInputElement;
  const imageWidthInput = document.getElementById('imageWidth') as HTMLInputElement;
  const imageHeightInput = document.getElementById('imageHeight') as HTMLInputElement;
  const focalLengthInput = document.getElementById('focalLength') as HTMLInputElement;
  const altitudeInput = document.getElementById('altitudeAgl') as HTMLInputElement;
  const altitudeSlider = document.getElementById('altitudeSlider') as HTMLInputElement;
  const forwardOverlapInput = document.getElementById('forwardOverlap') as HTMLInputElement;
  const lateralOverlapInput = document.getElementById('lateralOverlap') as HTMLInputElement;
  const desiredGsdInput = document.getElementById('desiredGsd') as HTMLInputElement;
  const missionAreaInput = document.getElementById('missionArea') as HTMLInputElement;

  const gsdNumberLarge = document.getElementById('gsdNumberLarge') as HTMLElement;
  const scaleFill = document.getElementById('scaleFill') as HTMLElement;
  const classificationBadge = document.getElementById('classificationBadge') as HTMLElement;
  const totalImages = document.getElementById('totalImages') as HTMLElement;
  const flightLines = document.getElementById('flightLines') as HTMLElement;
  const flightTime = document.getElementById('flightTime') as HTMLElement;
  const dataVolume = document.getElementById('dataVolume') as HTMLElement;
  const areaDisplay = document.getElementById('areaDisplay') as HTMLElement;
  const spacingDisplay = document.getElementById('spacingDisplay') as HTMLElement;
  const areaUnit = document.getElementById('areaUnit') as HTMLElement;
  const spacingUnit = document.getElementById('spacingUnit') as HTMLElement;
  const altUnit = document.getElementById('altUnit') as HTMLElement;
  const areaInputUnit = document.getElementById('areaInputUnit') as HTMLElement;
  const focalLengthUnit = document.getElementById('focalLengthUnit') as HTMLElement;
  const desiredGsdUnit = document.getElementById('desiredGsdUnit') as HTMLElement;
  const maxAltResult = document.getElementById('maxAltResult') as HTMLElement;
  const gsdUnitLabel = document.getElementById('gsdUnitLabel') as HTMLElement;
  const alertsContainer = document.getElementById('alertsContainer') as HTMLElement;
  const photo1Rect = document.getElementById('photo1Rect') as unknown as SVGRectElement;
  const photo2Rect = document.getElementById('photo2Rect') as unknown as SVGRectElement;
  const overlapRect = document.getElementById('overlapRect') as unknown as SVGRectElement;
  const overlapText = document.getElementById('overlapText') as SVGTextElement;

  const metricBtn = document.getElementById('metricBtn') as HTMLButtonElement;
  const imperialBtn = document.getElementById('imperialBtn') as HTMLButtonElement;
  const resetBtn = document.getElementById('resetBtn') as HTMLButtonElement;
  const shareBtn = document.getElementById('shareBtn') as HTMLButtonElement;
  const exportBtn = document.getElementById('exportBtn') as HTMLButtonElement;

  altitudeInput.addEventListener('input', () => {
    altitudeSlider.value = altitudeInput.value;
    calculate();
    saveState();
  });

  altitudeSlider.addEventListener('input', () => {
    altitudeInput.value = altitudeSlider.value;
    calculate();
    saveState();
  });

  cameraPresetSelect.addEventListener('change', () => {
    const preset = cameraPresets[cameraPresetSelect.value];
    if (preset) {
      sensorWidthInput.value = preset.sensorW.toString();
      sensorHeightInput.value = preset.sensorH.toString();
      imageWidthInput.value = preset.imgW.toString();
      imageHeightInput.value = preset.imgH.toString();
      focalLengthInput.value = preset.focal.toString();
      calculate();
      saveState();
    }
  });

  [sensorWidthInput, sensorHeightInput, imageWidthInput, imageHeightInput, focalLengthInput, forwardOverlapInput, lateralOverlapInput, missionAreaInput].forEach(input => {
    input.addEventListener('input', () => {
      calculate();
      saveState();
    });
  });

  desiredGsdInput.addEventListener('input', () => {
    const sensorW = parseFloat(sensorWidthInput.value) || 0;
    const focal = parseFloat(focalLengthInput.value) || 1;
    const imgW = parseFloat(imageWidthInput.value) || 1;
    const desiredGsd = parseFloat(desiredGsdInput.value) || 1;
    const maxAlt = (desiredGsd * focal * imgW) / (sensorW * 100);
    let altitudeValue = maxAlt;
    if (currentUnit === 'imperial') {
      altitudeValue = maxAlt * 3.28084;
    }

    // Update altitude input and slider
    altitudeInput.value = altitudeValue.toFixed(0);
    altitudeSlider.value = altitudeInput.value;

    // Display result with proper unit
    const displayAlt = currentUnit === 'metric' ? maxAlt : maxAlt * 3.28084;
    const unit = currentUnit === 'metric' ? 'm' : 'ft';
    maxAltResult.textContent = displayAlt.toFixed(2) + ' ' + unit;

    calculate();
    saveState();
  });

  metricBtn.addEventListener('click', () => {
    if (currentUnit === 'metric') return;
    currentUnit = 'metric';
    metricBtn.classList.add('active');
    imperialBtn.classList.remove('active');

    // Convert all inputs from imperial to metric
    sensorWidthInput.value = (parseFloat(sensorWidthInput.value) / 0.03937).toFixed(1); // inches to mm
    sensorHeightInput.value = (parseFloat(sensorHeightInput.value) / 0.03937).toFixed(1);
    altitudeInput.value = (parseFloat(altitudeInput.value) * 0.3048).toFixed(0); // feet to m
    altitudeSlider.value = altitudeInput.value;
    altitudeInput.max = '500';
    altitudeSlider.max = '500';

    updateUnits();
    updateLabels();
    calculate();
    saveState();
  });

  imperialBtn.addEventListener('click', () => {
    if (currentUnit === 'imperial') return;
    currentUnit = 'imperial';
    imperialBtn.classList.add('active');
    metricBtn.classList.remove('active');

    // Convert all inputs from metric to imperial
    sensorWidthInput.value = (parseFloat(sensorWidthInput.value) * 0.03937).toFixed(2); // mm to inches
    sensorHeightInput.value = (parseFloat(sensorHeightInput.value) * 0.03937).toFixed(2);
    altitudeInput.value = (parseFloat(altitudeInput.value) / 0.3048).toFixed(0); // m to feet
    altitudeSlider.value = altitudeInput.value;
    altitudeInput.max = '1640';
    altitudeSlider.max = '1640';

    updateUnits();
    updateLabels();
    calculate();
    saveState();
  });

  resetBtn.addEventListener('click', () => location.reload());

  function updateUnits() {
    altUnit.textContent = currentUnit === 'metric' ? 'm' : 'ft';
    areaUnit.textContent = currentUnit === 'metric' ? 'm²' : 'ft²';
    spacingUnit.textContent = currentUnit === 'metric' ? 'm' : 'ft';
    areaInputUnit.textContent = currentUnit === 'metric' ? 'm²' : 'ft²';
    gsdUnitLabel.textContent = currentUnit === 'metric' ? 'cm/px' : 'in/px';

    // Convert mission area if switching units
    const currentArea = parseFloat(missionAreaInput.value) || 0;
    if (currentUnit === 'imperial') {
      missionAreaInput.value = (currentArea * 10.764).toFixed(1);
    } else {
      missionAreaInput.value = (currentArea / 10.764).toFixed(1);
    }
  }

  function updateLabels() {
    // Update sensor width and height units
    const sensorWContainer = sensorWidthInput.parentElement?.parentElement;
    const sensorHContainer = sensorHeightInput.parentElement?.parentElement;

    if (sensorWContainer) {
      const unitHint = sensorWContainer.querySelector('.unit-hint');
      if (unitHint) {
        unitHint.textContent = currentUnit === 'metric' ? 'mm' : 'in';
      }
    }
    if (sensorHContainer) {
      const unitHint = sensorHContainer.querySelector('.unit-hint');
      if (unitHint) {
        unitHint.textContent = currentUnit === 'metric' ? 'mm' : 'in';
      }
    }

    // Update focal length unit
    focalLengthUnit.textContent = currentUnit === 'metric' ? 'mm' : 'in';

    // Update desired GSD unit
    desiredGsdUnit.textContent = currentUnit === 'metric' ? 'cm/px' : 'in/px';
  }

  function calculate() {
    const sensorW = parseFloat(sensorWidthInput.value) || 0;
    const sensorH = parseFloat(sensorHeightInput.value) || 0;
    const imgW = parseFloat(imageWidthInput.value) || 1;
    const focal = parseFloat(focalLengthInput.value) || 1;
    let altitude = parseFloat(altitudeInput.value) || 0;
    const forwardOverlap = parseFloat(forwardOverlapInput.value) || 0;
    const lateralOverlap = parseFloat(lateralOverlapInput.value) || 0;
    let missionArea = parseFloat(missionAreaInput.value) || 100;

    if (currentUnit === 'imperial') {
      altitude = altitude * 0.3048;
      missionArea = missionArea / 10.764; // Convert ft² to m²
    }

    const gsd = (altitude * sensorW) / (focal * imgW) * 100;
    gsdNumberLarge.textContent = gsd.toFixed(2);
    updatePrecisionScale(gsd);

    const footprintW = (altitude * sensorW) / focal;
    const footprintH = (altitude * sensorH) / focal;
    let coverage = footprintW * footprintH;

    if (currentUnit === 'imperial') {
      coverage = coverage * 10.764;
    }

    areaDisplay.textContent = coverage.toFixed(0);

    let spacing = footprintW * (1 - forwardOverlap / 100);
    if (currentUnit === 'imperial') {
      spacing = spacing * 3.28084;
    }
    spacingDisplay.textContent = spacing.toFixed(1);

    // Calculate mission metrics using actual mission area
    const linesNeeded = Math.ceil(missionArea / (footprintW * (1 - lateralOverlap / 100)));
    const spacingMeters = footprintW * (1 - forwardOverlap / 100);
    const shotsPerLine = Math.ceil(Math.sqrt(missionArea) / spacingMeters);
    const totalShots = Math.ceil(shotsPerLine * linesNeeded);

    totalImages.textContent = totalShots.toString();
    flightLines.textContent = linesNeeded.toString();
    flightTime.textContent = Math.ceil(totalShots * 2.5 / 60).toString();
    dataVolume.textContent = (totalShots * 20 / 1024).toFixed(1);

    // Update SVG overlap visualization
    const svgWidth = 220;
    const svgHeight = 100;
    const scale = Math.min((svgWidth - 40) / footprintW, (svgHeight - 40) / footprintW);
    const rectW = Math.max(20, Math.min(160, footprintW * scale));
    const rectH = Math.max(10, Math.min(60, footprintH * scale));

    // Position first photo
    const photo1X = 20;
    const photo1Y = (svgHeight - rectH) / 2;

    // Calculate second photo position based on forward overlap
    const overlapWidth = rectW * (forwardOverlap / 100);
    const photo2X = photo1X + rectW - overlapWidth;

    photo1Rect.setAttribute('x', photo1X.toString());
    photo1Rect.setAttribute('y', photo1Y.toString());
    photo1Rect.setAttribute('width', rectW.toString());
    photo1Rect.setAttribute('height', rectH.toString());

    photo2Rect.setAttribute('x', photo2X.toString());
    photo2Rect.setAttribute('y', photo1Y.toString());
    photo2Rect.setAttribute('width', rectW.toString());
    photo2Rect.setAttribute('height', rectH.toString());

    overlapRect.setAttribute('x', photo2X.toString());
    overlapRect.setAttribute('y', photo1Y.toString());
    overlapRect.setAttribute('width', overlapWidth.toString());
    overlapRect.setAttribute('height', rectH.toString());

    // Update overlap text
    overlapText.setAttribute('x', (photo2X + overlapWidth / 2).toString());
    overlapText.setAttribute('y', (photo1Y + rectH / 2 + 3).toString());
    overlapText.textContent = forwardOverlap.toString() + '%';

    alertsContainer.innerHTML = '';
    if (gsd < 0.5) {
      addAlert('Ultra-high resolution: Ensure sufficient storage and processing');
    }
    if (forwardOverlap < 60) {
      addAlert('Forward overlap below 60%: May affect 3D model quality');
    }
    if (totalShots > 5000) {
      addAlert('Very large dataset: Consider splitting into multiple flights');
    }
  }

  function updatePrecisionScale(gsd: number) {
    const clampedGsd = Math.max(0.5, Math.min(gsd, 20));
    const percentage = ((clampedGsd - 0.5) / 19.5) * 100;
    scaleFill.style.width = percentage + '%';

    let classification = 'Unknown';
    if (gsd <= 2) classification = 'High-Precision Topography';
    else if (gsd <= 5) classification = 'Standard Mapping';
    else if (gsd <= 10) classification = 'Inspection & Monitoring';
    else classification = 'Visual Survey';

    classificationBadge.textContent = classification;
  }

  function addAlert(message: string) {
    const alertEl = document.createElement('div');
    alertEl.className = 'alert';
    alertEl.textContent = message;
    alertsContainer.appendChild(alertEl);
  }

  shareBtn.addEventListener('click', async () => {
    const shareUrl = getShareUrl();
    try {
      await navigator.clipboard.writeText(shareUrl);
      const original = shareBtn.textContent;
      shareBtn.textContent = 'Copied to clipboard!';
      setTimeout(() => {
        shareBtn.textContent = original;
      }, 2000);
    } catch {
      // Fallback for older browsers
      alert('Copy this URL to share: ' + shareUrl);
    }
  });

  exportBtn.addEventListener('click', () => {
    const gsd = parseFloat(gsdNumberLarge.textContent || '0');
    const reportText = `GSD FLIGHT PLANNER
Camera: ${sensorWidthInput.value}x${sensorHeightInput.value}mm @${focalLengthInput.value}mm
Resolution: ${imageWidthInput.value}x${imageHeightInput.value}px
Altitude: ${altitudeInput.value}${altUnit.textContent} AGL
Overlap: ${forwardOverlapInput.value}% (Forward) / ${lateralOverlapInput.value}% (Lateral)

RESULTS
GSD: ${gsd.toFixed(2)} cm/px
Classification: ${classificationBadge.textContent}
Coverage: ${areaDisplay.textContent}${areaUnit.textContent}
Spacing: ${spacingDisplay.textContent}${spacingUnit.textContent}
Total Images: ${totalImages.textContent}
Flight Lines: ${flightLines.textContent}
Estimated Time: ${flightTime.textContent} min
Data Volume: ${dataVolume.textContent} GB

Generated: ${new Date().toLocaleString()}`;

    const blob = new Blob([reportText], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `gsd-plan-${Date.now()}.txt`;
    a.click();
  });

  // Initialize
  loadState();
  calculate();
  desiredGsdInput.dispatchEvent(new Event('input'));
</script>
