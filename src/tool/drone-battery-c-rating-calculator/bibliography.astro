---
import { BIBLIOGRAPHY_ITEMS } from './bibliography';
---

<div class="sc-bibliography">
  <ul>
    {
      BIBLIOGRAPHY_ITEMS.map((item) => (
        <li>
          <a href={item.url} target="_blank" rel="noopener noreferrer">
            {item.name}
          </a>
        </li>
      ))
    }
  </ul>
</div>
